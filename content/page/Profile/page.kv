
<Profile>:
    MDBoxLayout:
        orientation: "vertical"
        padding: [0, dp(40), 0, 0]
        spacing: 0
        md_bg_color: "#FFF9F0"

        # =========================
        # HEADER
        # =========================
        MDBoxLayout:
            id: header
            size_hint_y: None
            height: dp(112)
            padding: [dp(24), dp(16), dp(20), dp(16)]
            spacing: dp(16)

            canvas.after:
                Color:
                    rgba: 0.91, 0.84, 0.76, 1
                Line:
                    width: dp(1)
                    points: [self.x + dp(24), self.y, self.right - dp(24), self.y]

            MDRelativeLayout:
                size_hint: None, None
                size: dp(76), dp(76)
                radius: [dp(24)]
                md_bg_color: "#F5EBDD"

                MDIcon:
                    icon: "account"
                    pos_hint: {"center_x": .5, "center_y": .5}
                    font_size: dp(42)
                    theme_text_color: "Custom"
                    text_color: "#D87945"

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(3)
                adaptive_height: True
                pos_hint: {"center_y": .5}

                MDLabel:
                    text: "PLAYER PROFILE"
                    font_style: "Label"
                    role: "small"
                    theme_text_color: "Custom"
                    text_color: "#D87945"
                    adaptive_height: True

                MDLabel:
                    id: nama
                    text: "NAMA"
                    font_style: "Title"
                    role: "large"
                    theme_text_color: "Custom"
                    text_color: "#49372D"
                    shorten: True
                    adaptive_height: True

                MDLabel:
                    text: "Your personal character status"
                    font_style: "Body"
                    role: "small"
                    theme_text_color: "Custom"
                    text_color: "#A18D7A"
                    adaptive_height: True

            MDIconButton:
                icon: "cog-outline"
                style: "standard"
                size_hint: None, None
                size: dp(48), dp(48)
                pos_hint: {"center_y": .5}
                theme_icon_color: "Custom"
                icon_color: "#D87945"
                on_release: root.open_edit_modal()

        # =========================
        # SCROLL CONTENT
        # =========================
        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            bar_color: "#E99A62"
            bar_inactive_color: "#F5EBDD"

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(20), dp(20), dp(20), dp(200)]
                spacing: dp(18)

                # =========================
                # CHARACTER ATTRIBUTES
                # =========================
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)

                    MDLabel:
                        text: "CHARACTER ATTRIBUTES"
                        font_style: "Label"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: "#D87945"
                        adaptive_height: True


                    MDIcon:
                        icon: "star-four-points"
                        theme_text_color: "Custom"
                        text_color: "#E99A62"
                        size_hint: None, None
                        size: dp(22), dp(22)

                # =========================
                # WEIGHT AND HEIGHT
                # =========================
                MDGridLayout:
                    cols: 2
                    adaptive_height: True
                    spacing: dp(12)

                    # WEIGHT
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(16)
                        spacing: dp(10)
                        radius: [dp(20)]
                        md_bg_color: "#F5EBDD"

                        MDRelativeLayout:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            radius: [dp(13)]
                            md_bg_color: "#FCE2CF"

                            MDIcon:
                                icon: "weight-kilogram"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                theme_text_color: "Custom"
                                text_color: "#D87945"
                                font_size: dp(23)

                        MDLabel:
                            text: "WEIGHT"
                            font_style: "Label"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: "#A18D7A"
                            adaptive_height: True

                        MDLabel:
                            id: berat
                            text: "BB: -"
                            font_style: "Title"
                            role: "large"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            adaptive_height: True

                        MDLabel:
                            text: "Body attribute"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: "#B49D87"
                            adaptive_height: True

                    # HEIGHT
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(16)
                        spacing: dp(10)
                        radius: [dp(20)]
                        md_bg_color: "#F5EBDD"

                        MDRelativeLayout:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            radius: [dp(13)]
                            md_bg_color: "#FCE2CF"

                            MDIcon:
                                icon: "human-male-height"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                theme_text_color: "Custom"
                                text_color: "#D87945"
                                font_size: dp(23)

                        MDLabel:
                            text: "HEIGHT"
                            font_style: "Label"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: "#A18D7A"
                            adaptive_height: True

                        MDLabel:
                            id: tinggi
                            text: "TB: -"
                            font_style: "Title"
                            role: "large"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            adaptive_height: True

                        MDLabel:
                            text: "Body attribute"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: "#B49D87"
                            adaptive_height: True

                # =========================
                # HEALTH STATUS
                # =========================
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(20)
                    spacing: dp(5)
                    radius: [dp(22)]
                    md_bg_color: "#F5EBDD"

                    # CARD HEADER
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(20)

                        MDIcon:
                            icon: "heart-pulse"
                            theme_text_color: "Custom"
                            text_color: "#D87945"
                            size_hint: None, None
                            size: dp(24), dp(24)

                        MDLabel:
                            text: "HEALTH STATUS"
                            font_style: "Label"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            adaptive_height: True

                        MDIcon:
                            icon: "star-four-points"
                            theme_text_color: "Custom"
                            text_color: "#E99A62"
                            size_hint: None, None
                            size: dp(20), dp(20)

                    # IMT TITLE
                    MDLabel:
                        text: "Body Mass Index"
                        font_style: "Body"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: "#A18D7A"
                        pos_hint: {"center_x": .5, "center_y": .5}
                        adaptive_height: True

                    # IMT VALUE
                    MDLabel:
                        id: imt
                        text: "-"
                        font_style: "Display"
                        role: "large"
                        theme_text_color: "Custom"
                        text_color: "#49372D"
                        size_hint_y: None
                        height: dp(65)
                        padding: [0, dp(35), 0, 0]


                    # CATEGORY STATUS
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(36)
                        padding: [dp(12), 0, dp(12), 0]
                        radius: [dp(12)]
                        md_bg_color: "#E99A62"

                        MDLabel:
                            id: kategori
                            text: "STATUS: -"
                            font_style: "Label"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#FFFFFF"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            adaptive_height: True

                    # DIVIDER
                    MDDivider:
                        color: "#E8D8C5"

                    # BIRTH DATE
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDIcon:
                            icon: "cake-variant-outline"
                            theme_text_color: "Custom"
                            text_color: "#D87945"
                            size_hint: None, None
                            size: dp(22), dp(22)

                        MDLabel:
                            id: tanggal_lahir
                            text: "Tanggal lahir: -"
                            font_style: "Body"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            adaptive_height: True

                    # AGE
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDIcon:
                            icon: "calendar-clock"
                            theme_text_color: "Custom"
                            text_color: "#D87945"
                            size_hint: None, None
                            size: dp(22), dp(22)

                        MDLabel:
                            id: umur
                            text: "Umur: -"
                            font_style: "Body"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            adaptive_height: True