<Profile>:
    MDBoxLayout:
        orientation: "vertical"
        padding: [0, dp(48), 0, 0]
        md_bg_color: self.theme_cls.backgroundColor

        # ---------- HEADER ----------
        MDBoxLayout:
            id: header
            size_hint_y: None
            height: dp(104)
            padding: [dp(24), dp(12), dp(12), dp(12)]
            spacing: dp(16)

            canvas.after:
                Color:
                    rgba: app.theme_cls.outlineVariantColor
                Line:
                    width: dp(1)
                    points: [self.x + dp(24), self.y, self.right - dp(24), self.y]

            MDRelativeLayout:
                size_hint: None, None
                size: dp(72), dp(72)
                pos_hint: {"center_y": .5}
                radius: [dp(36)]
                md_bg_color: app.theme_cls.primaryContainerColor

                MDIcon:
                    icon: "account"
                    theme_font_size: "Custom"
                    pos_hint: {"center_x":.5, "center_y": .5}
                    font_size: dp(40)
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.onPrimaryContainerColor

            MDLabel:
                id: nama
                text: "NAMA"
                font_style: "Title"
                role: "large"
                size_hint_x: 1
                valign: "center"
                shorten: True
                shorten_from: "right"

            MDIconButton:
                icon: "cog"
                style: "standard"
                size_hint: None, None
                size: dp(48), dp(48)
                pos_hint: {"center_y": .5}
                theme_icon_color: "Custom"
                icon_color: app.theme_cls.onSurfaceColor
                on_release: root.open_edit_modal()

        # ---------- ISI ----------
        MDBoxLayout:
            orientation: "vertical"
            padding: [dp(20), dp(24), dp(20), dp(20)]
            spacing: dp(12)

            # Tile BB & TB
            MDBoxLayout:
                adaptive_height: True
                spacing: dp(12)

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(8)
                    radius: [dp(16)]
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    MDIcon:
                        icon: "weight-kilogram"
                        size_hint: None, None
                        size: dp(24), dp(24)
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primaryColor

                    MDLabel:
                        id: berat
                        text: "BB: -"
                        font_style: "Title"
                        role: "medium"
                        adaptive_height: True

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(16)
                    spacing: dp(8)
                    radius: [dp(16)]
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    MDIcon:
                        icon: "human-male-height"
                        size_hint: None, None
                        size: dp(24), dp(24)
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primaryColor

                    MDLabel:
                        id: tinggi
                        text: "TB: -"
                        font_style: "Title"
                        role: "medium"
                        adaptive_height: True

            # Kartu IMT
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(20)
                spacing: dp(8)
                radius: [dp(16)]
                md_bg_color: app.theme_cls.surfaceContainerColor

                MDLabel:
                    text: "Indeks Massa Tubuh"
                    font_style: "Title"
                    role: "medium"
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.onSurfaceVariantColor
                    adaptive_height: True

                MDLabel:
                    id: imt
                    text: "-"
                    font_style: "Display"
                    role: "small"
                    adaptive_height: True

                MDLabel:
                    id: kategori
                    text: "Status: -"
                    font_style: "Body"
                    role: "large"
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.primaryColor
                    adaptive_height: True

                MDDivider:
                    size_hint_y: None
                    height: dp(1)

                MDLabel:
                    id: tanggal_lahir
                    text: "Tanggal lahir: -"
                    adaptive_height: True

                MDLabel:
                    id: umur
                    text: "Umur: -"
                    adaptive_height: True

            Widget: