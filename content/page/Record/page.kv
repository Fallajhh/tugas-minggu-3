#:import MapView kivy_garden.mapview.MapView
#:import Factory kivy.factory.Factory
#:import Paths content.util.paths.Paths

<Record>:
    MapView:
        id: map_view
        lat: -6.9175
        lon: 107.6191
        zoom: 14

        TrackLine:
            id: track_line 

        TrackHumanPoin:
            id: human_position
            lat: -6.9175
            lon: 107.6191

    MDLabel:
        id: status
        text: "Menunggu GPS..."
        adaptive_height: True
        halign: "center"
        pos_hint: {"center_x": .5, "top": .95}

    MDButton:
        style: "filled"
        theme_bg_color: "Custom"
        md_bg_color: "#ca1111"
        size_hint_x: None
        width: dp(200)
        pos_hint: {"center_x": .5}
        y: dp(96)
        on_release: root.stop_tracking()

        MDButtonText:
            text: "STOP"
            pos_hint: {"center_x": .5, "center_y": .5}


<TrackHumanPoin@MapMarker>:
    size: dp(24), dp(24)
    anchor_x: 0.5
    anchor_y: 0.5
    source: Paths.asset("icon", "track.png")

<RecordModal>:
    size_hint: None, None
    width: dp(300)
    height: content.height
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.4

    MDBoxLayout:
        id: content
        orientation: "vertical"
        adaptive_height: True
        padding: dp(24)
        spacing: dp(16)
        radius: [dp(24)]
        md_bg_color: app.theme_cls.surfaceContainerColor

        MDLabel:
            text: "Record"
            font_style: "Title"
            role: "large"
            adaptive_height: True

        MDLabel:
            text: "Siap mulai merekam aktivitasmu?"
            font_style: "Body"
            role: "medium"
            theme_text_color: "Secondary"
            adaptive_height: True

        MDBoxLayout:
            adaptive_height: True
            spacing: dp(12)

            MDButton:
                style: "filled"
                theme_bg_color: "Custom"
                md_bg_color: "#9E9E9E"
                size_hint_x: 1
                on_release: root.dismiss()

                MDButtonText:
                    text: "Back"
                    pos_hint: {"center_x": .5, "center_y": .5}

            MDButton:
                style: "filled"
                theme_bg_color: "Custom"
                md_bg_color: "#FF6822"
                size_hint_x: 1
                on_release: root.on_start()

                MDButtonText:
                    text: "Start"
                    pos_hint: {"center_x": .5, "center_y": .5}