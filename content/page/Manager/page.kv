#:import MDSharedAxisTransition kivymd.uix.transition.MDSharedAxisTransition

<Manager>:
    orientation: "vertical"
    md_bg_color: app.theme_cls.backgroundColor

    MDScreenManager:
        id: screen_manager
        transition: MDSharedAxisTransition(transition_axis="x", duration=0.2)

        Home:
            name: "Home"
        Map:
            name: "Map"
        Record:
            name: "Record"
        Time:
            name: "Time"
        Profile:
            name: "Profile"

    MDBoxLayout:
        size_hint_y: None
        height: dp(80)
        padding: [dp(5), 0, dp(5), dp(8)]
    
        NavBar:
            on_switch_tabs: screen_manager.current = args[3]