# ======================= Chip jam =======================
<TimeChip>:
    adaptive_size: True
    padding: [dp(10), dp(6), dp(12), dp(6)]
    spacing: dp(4)
    radius: [dp(16)]
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.secondaryContainerColor

    MDIcon:
        icon: "clock-outline"
        adaptive_size: True
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: app.theme_cls.onSecondaryContainerColor
        theme_font_size: "Custom"
        font_size: dp(16)

    MDLabel:
        text: root.text
        bold: True
        adaptive_size: True
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: app.theme_cls.onSecondaryContainerColor


# ======================= Kartu jadwal =======================
<ScheduleCard>:
    orientation: "vertical"
    adaptive_height: True
    padding: dp(16)
    spacing: dp(12)
    radius: [dp(20)]
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.surfaceContainerColor

    MDBoxLayout:
        adaptive_height: True
        spacing: dp(12)

        MDRelativeLayout:
            size_hint: None, None
            size: dp(44), dp(44)
            pos_hint: {"center_y": .5}
            radius: [dp(22)]
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.primaryContainerColor

            MDIcon:
                icon: "silverware-fork-knife"
                adaptive_size: True
                pos_hint: {"center_x": .5, "center_y": .5}
                theme_text_color: "Custom"
                text_color: app.theme_cls.onPrimaryContainerColor

        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            pos_hint: {"center_y": .5}

            MDLabel:
                text: root.title
                font_style: "Title"
                role: "medium"
                adaptive_height: True

            MDLabel:
                text: str(len(root.times)) + "x makan sehari"
                theme_text_color: "Secondary"
                adaptive_height: True

        MDIconButton:
            icon: "delete-outline"
            pos_hint: {"center_y": .5}
            theme_icon_color: "Custom"
            icon_color: app.theme_cls.errorColor
            on_release: root.screen.delete_schedule(root.index)

    MDGridLayout:
        id: chips
        cols: 3
        adaptive_height: True
        spacing: dp(8)


# ======================= Modal tambah jadwal =======================
<AddScheduleModal>:
    size_hint: .92, None
    height: dp(500)
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, .45

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(24)
        spacing: dp(16)
        radius: [dp(28)]
        theme_bg_color: "Custom"
        md_bg_color: app.theme_cls.surfaceColor

        MDLabel:
            text: "Tambah Jadwal Makan"
            font_style: "Title"
            role: "large"
            adaptive_height: True

        MDTextField:
            id: name_input
            mode: "outlined"
            text: "Jadwal Makan"

            MDTextFieldHintText:
                text: "Nama jadwal"

        MDTextField:
            id: frequency_input
            mode: "outlined"
            text: "3"
            input_filter: "int"
            on_text: root.update_times(self.text)

            MDTextFieldHintText:
                text: "Frekuensi makan per hari (1-5)"

        MDTextField:
            id: time_input
            mode: "outlined"

            MDTextFieldHintText:
                text: "Jam (contoh: 07:00, 12:00, 19:00)"

        MDLabel:
            text: "Waktu otomatis dapat kamu ubah secara manual."
            theme_text_color: "Secondary"
            adaptive_height: True

        MDLabel:
            id: error_label
            text: ""
            theme_text_color: "Custom"
            text_color: app.theme_cls.errorColor
            adaptive_height: True

        MDBoxLayout:
            adaptive_height: True
            spacing: dp(8)

            Widget:

            MDButton:
                style: "text"
                on_release: root.dismiss()

                MDButtonText:
                    text: "Batal"

            MDButton:
                style: "filled"
                on_release: root.submit()

                MDButtonIcon:
                    icon: "check"

                MDButtonText:
                    text: "Simpan"


# ======================= Halaman utama =======================
<Time>:
    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(16)
        padding: dp(16)
        md_bg_color: app.theme_cls.backgroundColor

        # ===== Header =====
        MDBoxLayout:
            adaptive_height: True
            padding: dp(20)
            spacing: dp(12)
            radius: [dp(28)]
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.primaryContainerColor

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(4)
                pos_hint: {"center_y": .5}

                MDLabel:
                    text: "Jadwal Makan"
                    font_style: "Headline"
                    role: "small"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.onPrimaryContainerColor

                MDLabel:
                    text: "Atur pengingat waktu makan harianmu"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.onPrimaryContainerColor

            MDButton:
                style: "filled"
                pos_hint: {"center_y": .5}
                on_release: root.open_add_modal()

                MDButtonIcon:
                    icon: "plus"

                MDButtonText:
                    text: "Tambah"

        # ===== Tampilan kosong (tinggi 0 kalau sudah ada jadwal) =====
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height if root.empty else 0
            opacity: 1 if root.empty else 0
            padding: [0, dp(48), 0, 0]
            spacing: dp(10)

            MDIcon:
                icon: "silverware-fork-knife"
                halign: "center"
                pos_hint: {"center_x": .5}
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: app.theme_cls.outlineVariantColor
                theme_font_size: "Custom"
                font_size: dp(72)

            MDLabel:
                text: "Belum ada jadwal makan"
                halign: "center"
                font_style: "Title"
                role: "medium"
                adaptive_height: True

            MDLabel:
                text: "Tekan tombol Tambah untuk membuat jadwal pertamamu"
                halign: "center"
                theme_text_color: "Secondary"
                adaptive_height: True

        MDScrollView:
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                id: schedule_list
                orientation: "vertical"
                spacing: dp(12)
                adaptive_height: True
                padding: [0, 0, 0, dp(24)]